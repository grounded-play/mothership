{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build*/types/**/*.ts",
    ".next-build*/dev/types/**/*.ts",
    ".next-build-guidefix/types/**/*.ts",
    ".next-build-guidefix/dev/types/**/*.ts",
    ".next-build-mobilepass/types/**/*.ts",
    ".next-build-mobilepass/dev/types/**/*.ts",
    ".next-build-nativephone/types/**/*.ts",
    ".next-build-nativephone/dev/types/**/*.ts",
    ".next-build-layoutpass/types/**/*.ts",
    ".next-build-layoutpass/dev/types/**/*.ts",
    ".next-build-legible/types/**/*.ts",
    ".next-build-legible/dev/types/**/*.ts",
    ".next-build-layoutfill/types/**/*.ts",
    ".next-build-layoutfill/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
